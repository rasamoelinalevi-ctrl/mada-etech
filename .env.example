# Public deployment origin. Never derive payment callback URLs from request headers.
APP_URL=http://127.0.0.1:3000
# Production: required. Local development uses persistent PGlite in .data/postgres.
DATABASE_URL=
PAPI_API_KEY=
PAPI_WEBHOOK_SECRET=
# IMPORTANT: Papi test mode on a live merchant can still move real money.
PAPI_TEST_MODE=true
# Enable only after written confirmation and merchant acceptance testing.
PAPI_MASTERCARD_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Set only during administrator provisioning; remove afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
